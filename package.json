{
  "name": "rahman-xerox-billing",
  "version": "1.0.0",
  "description": "RAHMAN XEROX & SIFY IWAY - Billing & Shop Management",
  "main": "dist-electron/main.js",
  "author": "RAHMAN XEROX",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron": "electron dist-electron/main.js",
    "electron:dev": "npm run build:electron && electron dist-electron/main.js",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "lucide-react": "^0.344.0",
    "date-fns": "^3.3.1",
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.rahmanxerox.billing",
    "productName": "RAHMAN XEROX Billing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "./database",
        "to": "database"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
